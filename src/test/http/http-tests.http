@locationId = 7
@eventId = 1
@userId = 1

# the following variables are defined in .http-client.env.json
#   @token
#   @baseUrl


### Authentication check: should return 401 without a token
GET {{baseUrl}}/auth/me

### List locations
GET {{baseUrl}}/api/v1/locations
Authorization: Bearer {{token}}

### Get one location
GET {{baseUrl}}/api/v1/locations/{{locationId}}
Authorization: Bearer {{token}}

### Create a location
POST {{baseUrl}}/api/v1/locations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "locationName": "HTTP Test Location",
  "address": "100 HTTP Test Street",
  "locationDescription": "Created from IntelliJ HTTP Client"
}

### Replace a location
PUT {{baseUrl}}/api/v1/locations/{{locationId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "locationName": "Updated HTTP Location",
  "address": "200 HTTP Test Street",
  "locationDescription": "Replaced from IntelliJ HTTP Client"
}

### Partially update a location
PATCH {{baseUrl}}/api/v1/locations/{{locationId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "locationDescription": "Patched from IntelliJ HTTP Client"
}

### Get a missing location: should return 404
GET {{baseUrl}}/api/v1/locations/999
Authorization: Bearer {{token}}

### List events
GET {{baseUrl}}/api/v1/events
Authorization: Bearer {{token}}

### Get one event
GET {{baseUrl}}/api/v1/events/{{eventId}}
Authorization: Bearer {{token}}

### Create an event
POST {{baseUrl}}/api/v1/events
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "eventName": "HTTP Test Event",
  "eventDescription": "Created from IntelliJ HTTP Client",
  "startsOn": "2026-11-15T18:00:00",
  "creatorId": 0,
  "locationId": {{locationId}}
}

### Replace an event
PUT {{baseUrl}}/api/v1/events/{{eventId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "eventName": "Updated HTTP Event",
  "eventDescription": "Replaced from IntelliJ HTTP Client",
  "startsOn": "2026-12-05T09:00:00",
  "creatorId": 0,
  "locationId": {{locationId}}
}

### Partially update an event
PATCH {{baseUrl}}/api/v1/events/{{eventId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "eventDescription": "Patched from IntelliJ HTTP Client"
}

### Get event attendee count
GET {{baseUrl}}/api/v1/events/{{eventId}}/totalAttendees
Authorization: Bearer {{token}}

### Get a missing event: should return 404
GET {{baseUrl}}/api/v1/events/999
Authorization: Bearer {{token}}

### Get a user's invites
GET {{baseUrl}}/api/v1/users/{{userId}}/invites
Authorization: Bearer {{token}}

### Get the current authenticated user
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}
